{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "argos-auditor",
  "description": "Argos — AI security operations platform (Electron + SolidJS). Open-sourced under MIT.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "predev": "cd packages/app && bun test --preload ./happydom.ts ./src --timeout 30000",
    "dev": "pnpm --filter @argos/desktop dev",
    "predev:desktop": "cd packages/app && bun test --preload ./happydom.ts ./src --timeout 30000",
    "dev:desktop": "pnpm --filter @argos/desktop dev",
    "predev:web": "cd packages/app && bun test --preload ./happydom.ts ./src --timeout 30000",
    "dev:web": "pnpm --filter @argos/app dev",
    "test": "cd packages/app && bun test --preload ./happydom.ts ./src --timeout 30000 && cd ../ui && bun test src --timeout 30000",
    "test:app": "cd packages/app && bun test --preload ./happydom.ts ./src --timeout 30000",
    "test:ui": "cd packages/ui && bun test src --timeout 30000",
    "test:ui:dom": "pnpm --filter @argos/ui test:dom",
    "test:unit": "pnpm test && pnpm --filter @argos/core test:ci && pnpm --filter @argos/desktop test && pnpm --filter @argos/server test && pnpm --filter argos test && pnpm --filter @argos/llm test && pnpm --filter @argos/effect-drizzle-sqlite test && pnpm --filter @argos/http-recorder test && pnpm test:scripts",
    "test:scripts": "bun test --timeout 30000 ./scripts/oxlint-argos.test.ts ./argos-config/skills/auditoria-recon/scripts/recon-core.test.ts ./argos-config/skills/auditoria-web/scripts/web-core.test.ts",
    "test:browser": "pnpm --filter @argos/app test:e2e",
    "test:go": "cd argos-bin && go test ./...",
    "test:all": "pnpm test:unit && pnpm test:ui:dom && pnpm test:browser && bun scripts/check-arch-rules.ts && pnpm test:go",
    "test:watch": "cd packages/app && bun test --watch --preload ./happydom.ts ./src --timeout 30000",
    "lint": "oxlint",
    "audit:design": "bun scripts/audit-design-system.ts",
    "sync:rules": "bun scripts/sync-finding-rules.ts",
    "check:rules": "bun scripts/sync-finding-rules.ts --check",
    "typecheck": "pnpm --filter @argos/desktop typecheck",
    "typecheck:all": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "postinstall": "pnpm --filter @argos/core fix-node-pty",
    "prepare": "husky"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/sdk/js"
    ]
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "@argos/plugin": "workspace:*",
    "@argos/script": "workspace:*",
    "@argos/sdk": "workspace:*",
    "typescript": "npm:@typescript/native-preview@7.0.0-dev.20251207.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iwiels/ARGOS.git"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "tree-sitter-powershell",
    "web-tree-sitter",
    "electron"
  ],
  "patchedDependencies": {
    "@npmcli/agent@4.0.0": "patches/@npmcli%2Fagent@4.0.0.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "@standard-community/standard-openapi@0.2.9": "patches/@standard-community%2Fstandard-openapi@0.2.9.patch",
    "solid-js@1.9.10": "patches/solid-js@1.9.10.patch",
    "virtua@0.49.1": "patches/virtua@0.49.1.patch",
    "@ai-sdk/xai@3.0.82": "patches/@ai-sdk%2Fxai@3.0.82.patch",
    "gcp-metadata@8.1.2": "patches/gcp-metadata@8.1.2.patch",
    "pacote@21.5.0": "patches/pacote@21.5.0.patch",
    "@ai-sdk/google@3.0.73": "patches/@ai-sdk%2Fgoogle@3.0.73.patch"
  }
}
