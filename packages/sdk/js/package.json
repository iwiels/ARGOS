{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@argos/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "bun ./script/build.ts"
  },
  "exports": {
    ".": "./src/index.ts",
