    "./gen/*": "./src/gen/*"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.10",
    "@tsconfig/node22": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "cross-spawn": "catalog:"
  }
}

